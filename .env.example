# --- Supabase ---------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
# Server-only. Used by webhooks, payment processing and crons. Never expose.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# --- App --------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
# WhatsApp do time comercial BENIT (CTA da landing). Só dígitos, com DDD. Ex.: 11999990000
NEXT_PUBLIC_SALES_WHATSAPP=

# --- Mercado Pago (cada restaurante conecta a própria conta via OAuth) -------
MP_CLIENT_ID=
MP_CLIENT_SECRET=
# "Assinatura secreta" das notificações Webhooks do app no painel do Mercado Pago
MP_WEBHOOK_SECRET=
# Só em desenvolvimento: aponte para o stub local (npm run mp:stub). Nunca defina em produção.
# MP_API_BASE_URL=http://localhost:4010
# MP_AUTH_BASE_URL=http://localhost:4010
# 32 bytes em base64 — cifra os tokens das lojas. Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENC_KEY=

# --- E-mail (Resend) ----------------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM="BENIT <no-reply@seu-dominio.com.br>"

# --- Crons (Vercel envia Authorization: Bearer <CRON_SECRET>) ----------------
CRON_SECRET=
